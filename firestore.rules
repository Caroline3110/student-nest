rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admins are listed by UID in /admins/{uid} (add them in the Firebase console).
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function shortString(field, max) {
      return request.resource.data[field] is string && request.resource.data[field].size() <= max;
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /housekeepers/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Students apply as 'pending'; only admins can approve, edit or add directly.
    match /tutors/{id} {
      allow read: if signedIn() && (resource.data.status == 'approved' || isAdmin());
      allow create: if isAdmin() || (signedIn() && request.resource.data.status == 'pending');
      allow update, delete: if isAdmin();
    }

    function optionalString(field, max) {
      return !(field in request.resource.data) || shortString(field, max);
    }

    // Student profile, filled in on first login and edited from Settings.
    match /users/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
             'name', 'university', 'campus', 'major', 'year', 'bio',
             'language', 'profileComplete', 'updatedAt'])
        && optionalString('name', 80)
        && optionalString('university', 120)
        && optionalString('campus', 120)
        && optionalString('major', 120)
        && optionalString('year', 30)
        && optionalString('bio', 300)
        && (!('language' in request.resource.data) || request.resource.data.language in ['en', 'zh']);
    }

    // Private study data (tasks, exams, timetable, ...).
    match /users/{uid}/{collection}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // One profile per user, stored at /roommates/{uid}.
    match /roommates/{uid} {
      allow read: if signedIn();
      allow delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.ownerUid == uid
        && request.resource.data.keys().hasOnly([
             'ownerUid', 'name', 'nationality', 'university', 'year', 'budget', 'area',
             'hobbies', 'lifestyle', 'about', 'whatsapp', 'email', 'createdAt'])
        && shortString('name', 80)
        && shortString('nationality', 60)
        && shortString('university', 120)
        && shortString('year', 30)
        && request.resource.data.budget is number
        && shortString('area', 120)
        && shortString('hobbies', 300)
        && request.resource.data.lifestyle is list
        && request.resource.data.lifestyle.size() <= 10
        && shortString('about', 1000)
        && shortString('whatsapp', 30)
        && shortString('email', 120)
        && shortString('createdAt', 40);
    }

    // Anything not matched above is closed.
  }
}
